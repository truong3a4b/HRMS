// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

//npx prisma migrate dev --name init_hrms
//npx prisma generate
//npx prisma format
//npx prisma migrate reset
//npx prisma db push --accept-data-loss
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
  CANDIDATE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      UserRole @default(CANDIDATE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens     RefreshToken[]
  candidate         Candidate?
  employee          Employee?
  sentNotifications Notification[]          @relation("NotificationSender")
  notifications     NotificationRecipient[]
  requestedRequests Request[]               @relation("RequestRequester")
  requestApprovals  RequestApproval[]       @relation("RequestApprover")
  watchedRequests   RequestWatcher[]        @relation("RequestWatcherUser")
}

model PendingUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmployeeStatus {
  WORKING
  ON_LEAVE
  RESIGNED
}

enum JobApplicationStatus {
  NOT_APPLIED
  APPLIED
  INTERVIEWING
  OFFER_SENT
  OFFER_DECLINED
  ONBOARDED
  CANCELLED
  REJECTED
}

enum InterviewScheduleStatus {
  INVITED
  CONFIRMED
  DECLINED
  COMPLETED
  CANCELLED
}

enum RecruitmentJobStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String?  @unique
  description String?
  managerId   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees       Employee[]           @relation("DepartmentEmployees")
  manager         Employee?            @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  jobHistories    EmployeeJobHistory[]
  jobApplications JobApplication[]
  recruitmentJobs RecruitmentJob[]
  offers          Offer[]

  @@map("departments")
}

model Position {
  id          String   @id @default(uuid())
  name        String
  code        String?  @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees       Employee[]
  jobHistories    EmployeeJobHistory[]
  permissions     PositionPermission[]
  jobApplications JobApplication[]
  recruitmentJobs RecruitmentJob[]

  @@map("positions")
}

model RecruitmentJob {
  id           String               @id @default(uuid())
  positionId   String
  departmentId String
  title        String
  description  String
  requirements String
  benefits     String
  salaryMin    Decimal?             @db.Decimal(15, 2)
  salaryMax    Decimal?             @db.Decimal(15, 2)
  quantity     Int
  deadline     DateTime?
  status       RecruitmentJobStatus @default(OPEN)
  createdById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  position     Position         @relation(fields: [positionId], references: [id], onDelete: Restrict)
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy    Employee?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([status, deadline])
  @@index([positionId, departmentId])
  @@index([createdById])
  @@map("recruitment_jobs")
}

model Candidate {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String?
  email       String    @unique
  phone       String?
  dateOfBirth DateTime?
  gender      Gender?
  address     String?
  avatar      String?
  cvUrl       String?

  maritalStatus String?
  nationality   String?
  religion      String?

  bankAccount String?
  bank        Json?

  identityCardNumber     String?
  identityCardIssueDate  DateTime?
  frontIdentityCardImage String?
  backIdentityCardImage  String?

  province Json?
  ward     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  employee     Employee?

  @@index([email])
  @@map("candidates")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  positions PositionPermission[]

  @@map("permissions")
}

model PositionPermission {
  positionId   String
  permissionId String
  createdAt    DateTime @default(now())

  position   Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([positionId, permissionId])
  @@index([permissionId])
  @@map("position_permissions")
}

model Employee {
  id         String  @id @default(uuid())
  employeeId String  @unique
  name       String
  email      String  @unique
  phone      String?
  avatar     String?

  status      EmployeeStatus @default(WORKING)
  dateOfBirth DateTime?
  gender      Gender?
  address     String?
  hireDate    DateTime?
  salary      Decimal?       @db.Decimal(15, 2)

  bankAccount   String?
  bank          Json?
  maritalStatus String?
  nationality   String?
  religion      String?

  identityCardNumber     String?
  identityCardIssueDate  DateTime?
  frontIdentityCardImage String?
  backIdentityCardImage  String?

  province Json?
  ward     Json?

  userId       String? @unique
  candidateId  String? @unique
  departmentId String?
  positionId   String?

  user                         User?                         @relation(fields: [userId], references: [id])
  candidate                    Candidate?                    @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  department                   Department?                   @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  managedDepartment            Department?                   @relation("DepartmentManager")
  position                     Position?                     @relation(fields: [positionId], references: [id])
  jobHistories                 EmployeeJobHistory[]
  workSchedules                WorkSchedule[]
  fingerprints                 EmployeeFingerprint[]
  attendanceLogs               AttendanceLog[]
  attendanceRecords            AttendanceRecord[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  leaveBalances                EmployeeLeaveBalance[]
  allowances                   EmployeeAllowance[]
  payrollProfile               EmployeePayrollProfile?
  payrollBonusPenalties        PayrollBonusPenalty[]
  payrolls                     Payroll[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviewSchedules     InterviewSchedule[]   @relation("InterviewScheduleCreatedBy")
  interviewEvaluations   InterviewEvaluation[] @relation("InterviewEvaluationEvaluator")
  createdRecruitmentJobs RecruitmentJob[]

  @@index([departmentId])
  @@index([positionId])
  @@map("employees")
}

model JobApplication {
  id                 String               @id @default(uuid())
  candidateId        String
  recruitmentJobId   String?
  positionId         String
  departmentId       String?
  candidateAvatar    String?
  candidateName      String?
  candidateEmail     String?
  candidatePhone     String?
  candidateBirthDate DateTime?
  candidateGender    Gender?
  candidateCvUrl     String?
  candidateAddress   String?
  status             JobApplicationStatus @default(APPLIED)
  proposedSalary     Decimal?             @db.Decimal(15, 2)
  proposedHireDate   DateTime?
  coverLetter        String?
  notes              String?
  appliedAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  rejectedAt         DateTime?
  cancelledAt        DateTime?
  onboardedAt        DateTime?

  candidate          Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  recruitmentJob     RecruitmentJob?       @relation(fields: [recruitmentJobId], references: [id], onDelete: SetNull)
  position           Position              @relation(fields: [positionId], references: [id], onDelete: Restrict)
  department         Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  interviewSchedules InterviewSchedule[]
  evaluations        InterviewEvaluation[]
  offers             Offer[]

  @@index([candidateId, status])
  @@index([candidateId, recruitmentJobId])
  @@index([positionId, status])
  @@index([departmentId])
  @@index([recruitmentJobId])
  @@map("job_applications")
}

model InterviewSchedule {
  id                    String                  @id @default(uuid())
  jobApplicationId      String
  title                 String
  scheduledAt           DateTime
  type                  String? //loai hinh: online/offline
  location              String?
  interviewerNotes      String?
  candidateResponseAt   DateTime?
  candidateResponseNote String?
  status                InterviewScheduleStatus @default(INVITED)
  createdByEmployeeId   String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  createdBy      Employee?      @relation("InterviewScheduleCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  @@index([jobApplicationId, status])
  @@map("interview_schedules")
}

model InterviewEvaluation {
  id                  String   @id @default(uuid())
  jobApplicationId    String
  title               String
  evaluatorEmployeeId String?
  score               Int?
  strengths           String?
  concerns            String?
  recommendation      String?
  comments            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  evaluator      Employee?      @relation("InterviewEvaluationEvaluator", fields: [evaluatorEmployeeId], references: [id], onDelete: SetNull)

  @@index([jobApplicationId, createdAt])
  @@map("interview_evaluations")
}

enum OfferStatus {
  SENT
  ACCEPTED
  DECLINED
}

enum NotificationType {
  GENERAL
  SYSTEM
  RECRUITMENT
  EMPLOYEE
  AUTH
  CUSTOM
}

model Offer {
  id               String      @id @default(uuid())
  jobApplicationId String
  departmentId     String?
  proposedSalary   Decimal?    @db.Decimal(15, 2)
  proposedHireDate DateTime?
  notes            String?
  candidateNote    String?
  status           OfferStatus @default(SENT)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([jobApplicationId])
  @@map("offers")
}

model EmployeeJobHistory {
  id            String         @id @default(uuid())
  employeeId    String
  departmentId  String?
  positionId    String?
  hireDate      DateTime?
  salary        Decimal?       @db.Decimal(15, 2)
  status        EmployeeStatus @default(WORKING)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime       @default(now())

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])
  position   Position?   @relation(fields: [positionId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@index([employeeId, effectiveTo])
  @@index([departmentId])
  @@index([positionId])
  @@map("employee_job_histories")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  data      Json?
  senderId  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  sender     User?                   @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipients NotificationRecipient[]

  @@index([type, createdAt])
  @@index([senderId])
  @@map("notifications")
}

model NotificationRecipient {
  id             String    @id @default(uuid())
  notificationId String
  userId         String
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, isRead])
  @@index([notificationId])
  @@map("notification_recipients")
}

enum RequestType {
  LEAVE
  ATTENDANCE_CORRECTION
  OVERTIME
  SCHEDULE_APPROVAL
  TERMINATION
}

enum RequestStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  CANCELLED
  FAILED
}

enum RequestApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalMode {
  PARALLEL // duyệt đồng thời
  SEQUENTIAL // duyệt lần lượt
}

model Request {
  id           String        @id @default(uuid())
  type         RequestType
  title        String
  description  String?
  requesterId  String
  approvalMode ApprovalMode  @default(PARALLEL)
  status       RequestStatus @default(PENDING)
  currentStep  Int           @default(1)
  processingAt DateTime?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  requester                   User                         @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approvals                   RequestApproval[]
  watchers                    RequestWatcher[]
  leaveRequest                LeaveRequest?
  attendanceCorrectionRequest AttendanceCorrectionRequest?
  workScheduleRequest         WorkScheduleRequest?

  @@index([requesterId, status])
  @@index([status, createdAt])
  @@index([type])
  @@map("requests")
}

model RequestApproval {
  id         String                @id @default(uuid())
  requestId  String
  approverId String
  stepOrder  Int
  status     RequestApprovalStatus @default(PENDING)
  note       String?
  decidedAt  DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  request  Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User    @relation("RequestApprover", fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([requestId, approverId])
  @@index([requestId, stepOrder])
  @@index([approverId, status])
  @@map("request_approvals")
}

model RequestWatcher {
  id        String   @id @default(uuid())
  requestId String
  userId    String
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User    @relation("RequestWatcherUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([userId])
  @@index([requestId])
  @@map("request_watchers")
}

model LeaveRequest {
  id        String   @id @default(uuid())
  requestId String   @unique
  startDate DateTime
  endDate   DateTime
  leaveType String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model EmployeeLeaveBalance {
  id                String   @id @default(uuid())
  employeeId        String   @map("employee_id")
  year              Int
  entitledLeaveDays Decimal  @default(0) @map("entitled_leave_days") @db.Decimal(6, 2)
  usedPaidLeaveDays Decimal  @default(0) @map("used_paid_leave_days") @db.Decimal(6, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
  @@index([year])
  @@map("employee_leave_balances")
}

model AttendanceCorrectionRequest {
  id             String    @id @default(uuid())
  requestId      String    @unique
  employeeId     String
  attendanceDate DateTime
  workShiftId    String?
  addedWorkUnits Decimal   @db.Decimal(5, 2)
  reason         String?
  appliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  request   Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workShift WorkShift? @relation(fields: [workShiftId], references: [id], onDelete: SetNull)

  @@index([employeeId, attendanceDate])
  @@index([workShiftId])
  @@map("attendance_correction_requests")
}

model WorkShift {
  id                    String  @id @default(uuid())
  code                  String
  name                  String
  startTime             String
  endTime               String
  breakStartTime        String?
  breakEndTime          String?
  lateGracePeriod       Int     @default(0) //phút cho phép đi muộn mà không bị tính là đi muộn
  earlyLeaveGracePeriod Int     @default(0) //phút cho phép về sớm mà không bị tính là về sớm

  checkInStartTime  String //thời gian bắt đầu được check-in
  checkInEndTime    String //thời gian kết thúc được check-in
  checkOutStartTime String //thời gian bắt đầu được check-out
  checkOutEndTime   String //thời gian kết thúc được check-out

  isOvernight        Boolean @default(false) //ca qua đêm, ngày trong lịch là ngày bắt đầu ca
  isOvertime         Boolean @default(false) //ca làm thêm giờ
  workUnits          Decimal @db.Decimal(5, 2) //số đơn vị công cho ca này, ví dụ 1.0 cho ca bình thường, 1.5 cho ca làm thêm giờ
  overtimeMultiplier Decimal @default(1.0) @db.Decimal(5, 2) //hệ số lương cho ca làm thêm giờ, ví dụ 1.5 cho ca làm thêm giờ

  isActive                     Boolean                       @default(true)
  workScheduleLinks            WorkScheduleShift[]
  attendanceRecordDetails      AttendanceRecordDetail[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  payrollOvertimeLines         PayrollOvertimeLine[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  @@index([code])
  @@map("work_shifts")
}

// Lịch làm việc của nhân viên, liên kết với ca làm việc cụ thể và trạng thái của lịch
model WorkSchedule {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime

  employee   Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftLinks WorkScheduleShift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@map("work_schedules")
}

model WorkScheduleShift {
  id             String @id @default(uuid())
  workScheduleId String
  workShiftId    String

  workSchedule WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)
  workShift    WorkShift    @relation(fields: [workShiftId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workScheduleId, workShiftId])
  @@index([workShiftId])
  @@map("work_schedule_shifts")
}

// Lich su lap ke hoach lam viec 
model WorkScheduleSetup {
  id                    String  @id @default(uuid())
  name                  String
  description           String?
  //danh sach phong ban va vi tri duoc ap dung mau lich lam viec nay
  applicableDepartments Json? //danh sách departmentId áp dụng mẫu lịch này
  applicablePositions   Json? //danh sách positionId áp dụng mẫu lịch này
  //ca lam viec va danh sach ngay dc ap dung trong thang
  scheduleDetails       Json //danh sách ca làm việc và ngày áp dụng, ví dụ: [{"date": "2024-07-01", "workShiftIds": ["shift1", "shift2"]}]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//Dang ky lich lam viec
model WorkScheduleRequest {
  id        String   @id @default(uuid())
  requestId String   @unique
  month     DateTime //tháng đăng ký lịch làm việc, chỉ lưu phần năm và tháng

  scheduleDetails Json //danh sách ca làm việc và ngày áp dụng, ví dụ: [{"date": "2024-07-01", "workShiftIds": ["shift1", "shift2"]}]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model AttendanceDevice {
  id              String    @id @default(uuid())
  name            String
  code            String    @unique
  location        String?
  isActive        Boolean   @default(true)
  isConnected     Boolean   @default(false)
  lastHeartbeatAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fingerprints EmployeeFingerprint[]
  commands     AttendanceDeviceCommand[]
  logs         AttendanceLog[]

  @@map("attendance_devices")
}

model EmployeeFingerprint {
  id         String  @id @default(uuid())
  employeeId String
  deviceId   String
  fingerId   Int //id luu tren thiet bi cham cong
  fingerName String? //ten ngon tay, ví dụ: "thumb", "index", "middle", "ring", "little"
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device   AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, fingerId])
  @@index([employeeId])
  @@map("employee_fingerprints")
}

model AttendanceDeviceCommand {
  id        String   @id @default(uuid())
  deviceId  String
  command   String //lenh gui den thiet bi, ví dụ: "sync_time", "get_logs", "restart"
  payload   Json? //du lieu kem theo lenh, ví dụ: {"timestamp": "2024-07-01T08:00:00Z"} cho lenh sync_time
  status    String //trang thai lenh, ví dụ: "pending", "sent", "success", "failed"
  result    Json? //ket qua tra ve tu thiet bi, ví dụ: {"logsSynced": 100} cho lenh get_logs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
  @@map("attendance_device_commands")
}

model AttendanceLog {
  id         String   @id @default(uuid())
  employeeId String
  deviceId   String
  fingerId   Int
  timestamp  DateTime

  createdAt DateTime @default(now())

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device   AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([employeeId, timestamp])
  @@index([deviceId, timestamp])
  @@map("attendance_logs")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_LEAVE
  LATE_AND_EARLY_LEAVE
  ON_LEAVE
  PAID_LEAVE
  UNPAID_LEAVE
}

model AttendanceRecord {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  details  AttendanceRecordDetail[]

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@map("attendance_records")
}

model AttendanceRecordDetail {
  id                         String   @id @default(uuid())
  attendanceRecordId         String
  workShiftId                String
  //snapshot thong tin cua ca lam viec tai thoi diem cham cong, de truoc sau nay co thay doi lich lam viec thi van co thong tin cu de doi chieu
  workShiftCode              String?
  workShiftName              String
  shiftStartClock            String?
  shiftEndClock              String?
  shiftStartTime             DateTime
  shiftEndTime               DateTime
  shiftBreakStartTime        String?
  shiftBreakEndTime          String?
  shiftLateGracePeriod       Int?
  shiftEarlyLeaveGracePeriod Int?
  shiftCheckInStartTime      String?
  shiftCheckInEndTime        String?
  shiftCheckOutStartTime     String?
  shiftCheckOutEndTime       String?
  shiftIsOvernight           Boolean  @default(false)
  shiftIsOvertime            Boolean  @default(false)
  shiftWorkUnits             Decimal? @db.Decimal(5, 2)
  shiftOvertimeMultiplier    Decimal? @db.Decimal(5, 2)

  checkInTime  DateTime?
  checkOutTime DateTime?
  status       AttendanceStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  workShift        WorkShift        @relation(fields: [workShiftId], references: [id], onDelete: Restrict)

  @@unique([attendanceRecordId, workShiftId])
  @@index([attendanceRecordId])
  @@index([workShiftId])
  @@map("attendance_record_details")
}

//bang luu thong tin ve chinh sach bao hiem, bao gom ty le dong cua nguoi lao dong va cong ty, thoi gian hieu luc, de sau nay co the thay doi va luu lai lich su thay doi
model InsurancePolicy {
  id   String @id @default(uuid())
  name String

  employeeSocialRate       Decimal // BHXH NLĐ đóng, ví dụ 8
  employeeHealthRate       Decimal // BHYT, ví dụ 1.5
  employeeUnemploymentRate Decimal // BHTN, ví dụ 1

  employerSocialRate       Decimal? // phần công ty đóng
  employerHealthRate       Decimal?
  employerUnemploymentRate Decimal?

  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollProfiles EmployeePayrollProfile[]

  @@index([isActive, effectiveFrom])
  @@map("insurance_policies")
}

model TaxPolicy {
  id   String @id @default(uuid())
  name String

  personalDeduction  Decimal // 11_000_000
  dependentDeduction Decimal // 4_400_000

  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  brackets TaxBracket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollProfiles EmployeePayrollProfile[]

  @@index([isActive, effectiveFrom])
  @@map("tax_policies")
}

model TaxBracket {
  id       String @id @default(uuid())
  policyId String

  fromAmount Decimal
  toAmount   Decimal?
  rate       Decimal

  policy TaxPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("tax_brackets")
}

model AttendanceBonusPolicy {
  id String @id @default(uuid())

  name   String
  amount Decimal @db.Decimal(15, 2) // số tiền thưởng

  requiredWorkDays Decimal? //số ngày làm việc yêu cầu trong tháng để được thưởng, ví dụ 22.5
  maxLateMinutes   Int? //số phút đi muộn tối đa được tính vào thưởng
  maxEarlyMinutes  Int? //số phút nghỉ sớm tối đa được tính vào thưởng
  maxAbsentDays    Decimal? //số ngày vắng mặt tối đa được tính vào thưởng

  isActive Boolean @default(true)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollProfiles EmployeePayrollProfile[]

  @@index([isActive, effectiveFrom])
  @@map("attendance_bonus_policies")
}

model AllowancePolicy {
  id            String    @id @default(uuid())
  name          String
  description   String?
  amount        Decimal   @db.Decimal(15, 2)
  isActive      Boolean   @default(true)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employeeAllowances EmployeeAllowance[]
  payrollLines       PayrollAllowanceLine[]

  @@index([isActive, effectiveFrom])
  @@map("allowance_policies")
}

model EmployeeAllowance {
  id                String @id @default(uuid())
  employeeId        String
  allowancePolicyId String

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allowancePolicy AllowancePolicy @relation(fields: [allowancePolicyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, allowancePolicyId])
  @@index([employeeId])
  @@index([allowancePolicyId])
  @@map("employee_allowances")
}

model EmployeePayrollProfile {
  id         String @id @default(uuid())
  employeeId String @unique

  insurancePolicyId       String?
  taxPolicyId             String?
  attendanceBonusPolicyId String?

  isInsuranceApplicable       Boolean @default(false)
  isTaxApplicable             Boolean @default(false)
  isAttendanceBonusApplicable Boolean @default(false)

  insuranceSalary Decimal? //mức lương để tính bảo hiểm, nếu khác với lương thực tế thì sẽ dùng mức này để tính
  dependentCount  Int      @default(0) //số người phụ thuộc để tính thuế
  taxCode         String? //mã số thuế cá nhân, nếu có

  employee              Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  insurancePolicy       InsurancePolicy?       @relation(fields: [insurancePolicyId], references: [id])
  taxPolicy             TaxPolicy?             @relation(fields: [taxPolicyId], references: [id])
  attendanceBonusPolicy AttendanceBonusPolicy? @relation(fields: [attendanceBonusPolicyId], references: [id])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([insurancePolicyId])
  @@index([taxPolicyId])
  @@index([attendanceBonusPolicyId])
  @@map("employee_payroll_profiles")
}

model PayrollBonusPenalty {
  id         String   @id @default(uuid())
  employeeId String
  month      DateTime //tháng áp dụng, chỉ lưu phần năm và tháng
  amount     Decimal  @db.Decimal(15, 2)
  isBonus    Boolean  @default(true) //true là thưởng, false là phạt
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee     Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollLines PayrollBonusPenaltyLine[]

  @@index([employeeId, month])
  @@map("payroll_bonus_penalties")
}

model Payroll {
  id         String @id @default(uuid())
  employeeId String

  month Int
  year  Int

  // Lương & công
  baseSalary       Decimal @default(0)
  standardWorkDays Decimal @default(0)
  actualWorkDays   Decimal @default(0)
  actualSalary     Decimal @default(0) // lương thực/lương chính theo công

  // Tổng OT
  totalOvertimeWorkDays Decimal @default(0)
  totalOvertimeHours    Decimal @default(0)
  totalOvertimePay      Decimal @default(0)

  // Tổng phụ cấp/thưởng/phạt
  totalAllowance Decimal @default(0)
  totalBonus     Decimal @default(0)
  totalPenalty   Decimal @default(0)

  // Bảo hiểm
  socialInsurance        Decimal @default(0) // BHXH
  healthInsurance        Decimal @default(0) // BHYT
  unemploymentInsurance  Decimal @default(0) // BHTN
  laborAccidentInsurance Decimal @default(0) // BHLD/BNN neu co

  // Thuế
  personalIncomeTax Decimal @default(0)

  // Tổng kết
  grossSalary    Decimal @default(0)
  totalDeduction Decimal @default(0)
  netSalary      Decimal @default(0)

  status PayrollStatus @default(DRAFT)

  generatedAt DateTime  @default(now())
  approvedAt  DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  overtimeLines     PayrollOvertimeLine[]
  allowanceLines    PayrollAllowanceLine[]
  bonusPenaltyLines PayrollBonusPenaltyLine[]

  @@unique([employeeId, month, year])
  @@index([year, month])
  @@index([status])
  @@map("payrolls")
}

enum PayrollStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

model PayrollOvertimeLine {
  id        String @id @default(uuid())
  payrollId String

  workShiftId   String?
  workShiftCode String?
  workShiftName String

  workDays Decimal @default(0) @db.Decimal(8, 2)
  hours    Decimal @default(0) @db.Decimal(8, 2)

  baseHourlyRate Decimal @default(0) @db.Decimal(15, 2)
  multiplier     Decimal @default(1) @db.Decimal(6, 2)
  amount         Decimal @default(0) @db.Decimal(15, 2)

  payroll   Payroll    @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  workShift WorkShift? @relation(fields: [workShiftId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payrollId])
  @@index([workShiftId])
  @@map("payroll_overtime_lines")
}

model PayrollAllowanceLine {
  id        String @id @default(uuid())
  payrollId String

  allowancePolicyId String?
  allowanceName     String
  amount            Decimal @default(0) @db.Decimal(15, 2)

  payroll         Payroll          @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  allowancePolicy AllowancePolicy? @relation(fields: [allowancePolicyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payrollId])
  @@index([allowancePolicyId])
  @@map("payroll_allowance_lines")
}

model PayrollBonusPenaltyLine {
  id        String @id @default(uuid())
  payrollId String

  payrollBonusPenaltyId String?
  isBonus               Boolean @default(true)
  reason                String?
  amount                Decimal @default(0) @db.Decimal(15, 2)

  payroll             Payroll              @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  payrollBonusPenalty PayrollBonusPenalty? @relation(fields: [payrollBonusPenaltyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payrollId])
  @@index([payrollBonusPenaltyId])
  @@map("payroll_bonus_penalty_lines")
}
