generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  HR
  MANAGER
  EMPLOYEE
  CANDIDATE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      UserRole @default(CANDIDATE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PendingUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
