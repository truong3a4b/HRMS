//npx prisma migrate dev --name init_hrms
//npx prisma generate
//npx prisma format
//npx prisma migrate reset
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
  CANDIDATE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      UserRole @default(CANDIDATE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  candidate     Candidate?
  employee      Employee?
  sentNotifications Notification[]          @relation("NotificationSender")
  notifications     NotificationRecipient[]
  requestedRequests Request[]                @relation("RequestRequester")
  requestApprovals  RequestApproval[]        @relation("RequestApprover")
  watchedRequests   RequestWatcher[]         @relation("RequestWatcherUser")
}

model PendingUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmployeeStatus {
  WORKING
  ON_LEAVE
  RESIGNED
}

enum JobApplicationStatus {
  NOT_APPLIED
  APPLIED
  INTERVIEWING
  OFFER_SENT
  OFFER_DECLINED
  ONBOARDED
  CANCELLED
  REJECTED
}

enum InterviewScheduleStatus {
  INVITED
  CONFIRMED
  DECLINED
  COMPLETED
  CANCELLED
}

enum RecruitmentJobStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String?  @unique
  description String?
  managerId   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees       Employee[]           @relation("DepartmentEmployees")
  manager         Employee?            @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  jobHistories    EmployeeJobHistory[]
  jobApplications JobApplication[]
  recruitmentJobs RecruitmentJob[]
  offers          Offer[]

  @@map("departments")
}

model Position {
  id          String   @id @default(uuid())
  name        String
  code        String?  @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees       Employee[]
  jobHistories    EmployeeJobHistory[]
  permissions     PositionPermission[]
  jobApplications JobApplication[]
  recruitmentJobs RecruitmentJob[]

  @@map("positions")
}

model RecruitmentJob {
  id           String               @id @default(uuid())
  positionId   String
  departmentId String
  title        String
  description  String
  requirements String
  benefits     String
  salaryMin    Decimal?             @db.Decimal(15, 2)
  salaryMax    Decimal?             @db.Decimal(15, 2)
  quantity     Int
  deadline     DateTime?
  status       RecruitmentJobStatus @default(OPEN)
  createdById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  position     Position         @relation(fields: [positionId], references: [id], onDelete: Restrict)
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy    Employee?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([status, deadline])
  @@index([positionId, departmentId])
  @@index([createdById])
  @@map("recruitment_jobs")
}

model Candidate {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String?
  email       String    @unique
  phone       String?
  dateOfBirth DateTime?
  gender      Gender?
  address     String?
  avatar      String?
  cvUrl       String?

  maritalStatus String?
  nationality   String?
  religion      String?

  bankAccount String?
  bank        Json?

  identityCardNumber     String?
  identityCardIssueDate  DateTime?
  frontIdentityCardImage String?
  backIdentityCardImage  String?

  province Json?
  ward     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  employee     Employee?

  @@index([email])
  @@map("candidates")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  positions PositionPermission[]

  @@map("permissions")
}

model PositionPermission {
  positionId   String
  permissionId String
  createdAt    DateTime @default(now())

  position   Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([positionId, permissionId])
  @@index([permissionId])
  @@map("position_permissions")
}

model Employee {
  id         String  @id @default(uuid())
  employeeId String  @unique
  name       String
  email      String  @unique
  phone      String?
  avatar     String?

  status      EmployeeStatus @default(WORKING)
  dateOfBirth DateTime?
  gender      Gender?
  address     String?
  hireDate    DateTime?
  salary      Decimal?       @db.Decimal(15, 2)

  bankAccount   String?
  bank          Json?
  maritalStatus String?
  nationality   String?
  religion      String?

  identityCardNumber     String?
  identityCardIssueDate  DateTime?
  frontIdentityCardImage String?
  backIdentityCardImage  String?

  province Json?
  ward     Json?

  userId       String? @unique
  candidateId  String? @unique
  departmentId String?
  positionId   String?

  user              User?                @relation(fields: [userId], references: [id])
  candidate         Candidate?           @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  department        Department?          @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  managedDepartment Department?          @relation("DepartmentManager")
  position          Position?            @relation(fields: [positionId], references: [id])
  jobHistories      EmployeeJobHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviewSchedules     InterviewSchedule[]   @relation("InterviewScheduleCreatedBy")
  interviewEvaluations   InterviewEvaluation[] @relation("InterviewEvaluationEvaluator")
  createdRecruitmentJobs RecruitmentJob[]

  @@index([departmentId])
  @@index([positionId])
  @@map("employees")
}

model JobApplication {
  id                 String               @id @default(uuid())
  candidateId        String
  recruitmentJobId   String?
  positionId         String
  departmentId       String?
  candidateAvatar    String?
  candidateName      String?
  candidateEmail     String?
  candidatePhone     String?
  candidateBirthDate DateTime?
  candidateGender    Gender?
  candidateCvUrl     String?
  candidateAddress   String?
  status             JobApplicationStatus @default(APPLIED)
  proposedSalary     Decimal?             @db.Decimal(15, 2)
  proposedHireDate   DateTime?
  coverLetter        String?
  notes              String?
  appliedAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  rejectedAt         DateTime?
  cancelledAt        DateTime?
  onboardedAt        DateTime?

  candidate          Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  recruitmentJob     RecruitmentJob?       @relation(fields: [recruitmentJobId], references: [id], onDelete: SetNull)
  position           Position              @relation(fields: [positionId], references: [id], onDelete: Restrict)
  department         Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  interviewSchedules InterviewSchedule[]
  evaluations        InterviewEvaluation[]
  offers             Offer[]

  @@index([candidateId, status])
  @@index([candidateId, recruitmentJobId])
  @@index([positionId, status])
  @@index([departmentId])
  @@index([recruitmentJobId])
  @@map("job_applications")
}

model InterviewSchedule {
  id                    String                  @id @default(uuid())
  jobApplicationId      String
  title                 String
  scheduledAt           DateTime
  type                  String? //loai hinh: online/offline
  location              String?
  interviewerNotes      String?
  candidateResponseAt   DateTime?
  candidateResponseNote String?
  status                InterviewScheduleStatus @default(INVITED)
  createdByEmployeeId   String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  createdBy      Employee?      @relation("InterviewScheduleCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  @@index([jobApplicationId, status])
  @@map("interview_schedules")
}

model InterviewEvaluation {
  id                  String   @id @default(uuid())
  jobApplicationId    String
  title               String
  evaluatorEmployeeId String?
  score               Int?
  strengths           String?
  concerns            String?
  recommendation      String?
  comments            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  evaluator      Employee?      @relation("InterviewEvaluationEvaluator", fields: [evaluatorEmployeeId], references: [id], onDelete: SetNull)

  @@index([jobApplicationId, createdAt])
  @@map("interview_evaluations")
}

enum OfferStatus {
  SENT
  ACCEPTED
  DECLINED
}

enum NotificationType {
  GENERAL
  SYSTEM
  RECRUITMENT
  EMPLOYEE
  AUTH
  CUSTOM
}

model Offer {
  id               String      @id @default(uuid())
  jobApplicationId String
  departmentId     String?
  proposedSalary   Decimal?    @db.Decimal(15, 2)
  proposedHireDate DateTime?
  notes            String?
  candidateNote    String?
  status           OfferStatus @default(SENT)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([jobApplicationId])
  @@map("offers")
}

model EmployeeJobHistory {
  id            String         @id @default(uuid())
  employeeId    String
  departmentId  String?
  positionId    String?
  hireDate      DateTime?
  salary        Decimal?       @db.Decimal(15, 2)
  status        EmployeeStatus @default(WORKING)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime       @default(now())

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])
  position   Position?   @relation(fields: [positionId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@index([employeeId, effectiveTo])
  @@index([departmentId])
  @@index([positionId])
  @@map("employee_job_histories")
}

model Notification {
  id          String           @id @default(uuid())
  type        NotificationType  @default(GENERAL)
  title       String
  message     String
  data        Json?
  senderId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sender      User?                    @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipients  NotificationRecipient[]

  @@index([type, createdAt])
  @@index([senderId])
  @@map("notifications")
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId  String
  userId          String
  isRead          Boolean      @default(false)
  readAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, isRead])
  @@index([notificationId])
  @@map("notification_recipients")
}

enum RequestType {
  LEAVE
  ATTENDANCE_CORRECTION
  OVERTIME
  SCHEDULE_APPROVAL
  TERMINATION
}

enum RequestStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  FAILED
}

enum RequestApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalMode {
  PARALLEL      // duyệt đồng thời
  SEQUENTIAL   // duyệt lần lượt
}

model Request {
  id           String           @id @default(uuid())
  type         RequestType
  title        String
  description  String?
  requesterId  String
  approvalMode  ApprovalMode     @default(PARALLEL)
  status       RequestStatus     @default(PENDING)
  currentStep  Int              @default(1)
  processingAt DateTime?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  cancelledAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  requester    User              @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approvals    RequestApproval[]
  watchers     RequestWatcher[]
  leaveRequest LeaveRequest?

  @@index([requesterId, status])
  @@index([status, createdAt])
  @@index([type])
  @@map("requests")
}

model RequestApproval {
  id         String                @id @default(uuid())
  requestId  String
  approverId String
  stepOrder  Int
  status     RequestApprovalStatus  @default(PENDING)
  note       String?
  decidedAt  DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  request    Request               @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver   User                  @relation("RequestApprover", fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([requestId, approverId])
  @@index([requestId, stepOrder])
  @@index([approverId, status])
  @@map("request_approvals")
}

model RequestWatcher {
  id        String   @id @default(uuid())
  requestId String
  userId    String
  createdAt DateTime @default(now())

  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User     @relation("RequestWatcherUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([userId])
  @@index([requestId])
  @@map("request_watchers")
}

model LeaveRequest {
  id String @id @default(uuid())
  requestId String @unique
  startDate DateTime
  endDate DateTime
  leaveType String
  reason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}